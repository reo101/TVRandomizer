<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TVRandomizer</AssemblyName>
    <Version>1.1.0</Version>
    <Description>Host-synchronized TVLoader playlist randomization</Description>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.403" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Xilophor.LethalNetworkAPI" Version="3.4.2" IncludeAssets="compile" PrivateAssets="all" />
    <ProjectReference Include="../TVRandomizer.Core/TVRandomizer.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Playback.fs" />
    <Compile Include="Plugin.fs" />
  </ItemGroup>
</Project>
